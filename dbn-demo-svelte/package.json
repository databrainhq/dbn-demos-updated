{
  "name": "svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,app -c blue,green \"npm run dev:backend\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "setup": "npm install && cd backend && npm install && cd .. && test -f backend/.env || cp backend/.env.example backend/.env && test -f .env || cp .env.example .env && echo '\\n✅ Setup complete. Edit backend/.env and .env, then run: npm run dev\\n'",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^2.0.4",
    "@tsconfig/svelte": "^4.0.1",
    "concurrently": "^9.1.0",
    "svelte": "^3.58.0",
    "svelte-check": "^3.3.1",
    "tslib": "^2.5.0",
    "typescript": "^5.0.2",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@databrainhq/plugin": "^0.16.34"
  }
}
