# Backend API (skeleton uses only guest-token)
VITE_API_URL=http://localhost:3002
# DataBrain plugin base URL
VITE_DATABRAIN_PLUGIN_URL=https://api.usedatabrain.com
# Client ID sent when requesting a guest token
VITE_DEFAULT_CLIENT_ID=default
# Dashboard/embed ID to show (from your DataBrain Data App)
VITE_DEFAULT_DASHBOARD_ID=
