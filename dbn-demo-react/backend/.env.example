# Databrain API Token — per-data-app token from Data App > API Token tab
# Docs: https://docs.usedatabrain.com/developer-docs/helpers/api-token
DATABRAIN_API_TOKEN=

# Data App name — must match the name in your Databrain workspace
DATA_APP_NAME=

# API base URL (default: https://api.usedatabrain.com)
# DATABRAIN_API_BASE_URL=https://api.usedatabrain.com

# Backend server port
PORT=3002
