# DataBrain Configuration
# Get these values from your DataBrain dashboard: https://app.usedatabrain.com/
# 1. API Token: Go to Settings > API Keys
# 2. Data App Name: Go to Data Apps section (must match exactly, case-sensitive)

DATABRAIN_API_KEY=your-databrain-api-token-here
DATABRAIN_DATA_APP_NAME=your-data-app-name-here
DATABRAIN_API_BASE_URL=https://api.usedatabrain.com
DATABRAIN_WORKSPACE_NAME=Demo Workspace

# Server Configuration
PORT=3001