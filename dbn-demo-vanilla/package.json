{
  "name": "dbn-demo-vanilla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,app -c blue,green \"npm run dev:backend\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "setup": "npm install && cd backend && npm install && cd .. && test -f backend/.env || cp backend/.env.example backend/.env && echo '\\n✅ Setup complete. Edit backend/.env, then run: npm run dev\\n'",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.1"
  },
  "dependencies": {
    "@databrainhq/plugin": "^0.16.34"
  }
}
