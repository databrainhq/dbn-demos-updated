# Vanilla demo has no bundler — configure IDs in src/main.js:
#   DASHBOARD_ID  — required embed/dashboard ID from your Data App
#   METRIC_ID     — optional metric embed ID for <dbn-metric> below the dashboard
#
# Backend: copy backend/.env.example to backend/.env and set:
#   DATABRAIN_API_TOKEN, DATA_APP_NAME (see backend/.env.example)
